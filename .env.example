# ==============================================================================
# VasukiPublication Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit real credentials, access tokens, or connection strings to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Connection (Server-Only)
# ------------------------------------------------------------------------------
# Connection string pointing to the MongoDB instance shared with VasukiSquare.
# Example: mongodb://localhost:27017 or mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name containing books, pages, covers, and ads collections.
MONGODB_DATABASE=vasukisquare

# ------------------------------------------------------------------------------
# Administrative Secrets (Server-Only)
# ------------------------------------------------------------------------------
# Bearer token required for future admin/publishing webhook endpoints.
ADMIN_ACCESS_TOKEN=

# Secret string used to sign/verify administrative session cookies or tokens.
ADMIN_SESSION_SECRET=

# ------------------------------------------------------------------------------
# Public Site Configuration (Client & Server)
# ------------------------------------------------------------------------------
# Canonical public URL for generating absolute links, sitemaps, and OpenGraph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public branding name displayed in headers, titles, and metadata.
NEXT_PUBLIC_SITE_NAME=Vasuki Publication

# ------------------------------------------------------------------------------
# Runtime Environment
# ------------------------------------------------------------------------------
NODE_ENV=development

